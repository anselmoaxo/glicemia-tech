# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel:
#   Projeto > Settings > Environment Variables. Depois faça um Redeploy.
# NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.

# ── Banco (Neon PostgreSQL) ───────────────────────────────────────────────
# Use a connection string com sslmode=require (de preferência a "pooled").
DATABASE_URL=

# ── Autenticação (Better Auth) ────────────────────────────────────────────
# Gere um valor aleatório de 32+ caracteres: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app. Em produção, o domínio com https://. Na Vercel, se ficar vazio,
# o app usa o domínio de produção do projeto.
BETTER_AUTH_URL=http://localhost:3000

# ── Administração ─────────────────────────────────────────────────────────
# IDs (não e-mails) das contas com acesso a /admin, separados por vírgula.
# O ID aparece na tabela "users" do banco. Vazio = ninguém é administrador.
ADMIN_USER_IDS=

# ── E-mail (Resend) ───────────────────────────────────────────────────────
# Usado em: convites de familiares e alertas de glicemia fora da faixa.
# Sem RESEND_API_KEY o app funciona: o link do convite aparece na tela para copiar
# e os alertas por e-mail não são enviados.
#
# Como configurar (passo a passo no README, seção "E-mail com Resend"):
#  1. resend.com > Domains > Add Domain, e cadastre no seu provedor de DNS os registros que ele mostrar
#     (SPF e DKIM). Sem domínio verificado o Resend só entrega para o e-mail da sua própria conta.
#  2. resend.com > API Keys > Create API Key (permissão "Sending access").
#  3. Cadastre as duas variáveis abaixo na Vercel (a chave como "Sensitive") e faça Redeploy.
RESEND_API_KEY=
# Remetente: precisa ser um endereço do domínio verificado. Formato: Nome <endereco@dominio>.
# Sem domínio, para testar, use o remetente de teste do Resend (só entrega para o dono da conta):
#   EMAIL_FROM=Glicose Tech <onboarding@resend.dev>
EMAIL_FROM=Glicose Tech <avisos@seudominio.com.br>
# Exigir e-mail CONFIRMADO para entrar. Deixe vazio/false até ter certeza de que os e-mails chegam;
# com true, quem não confirmar não consegue entrar. Só vale se RESEND_API_KEY existir.
# Antes de ligar, marque as contas já existentes como confirmadas (elas foram criadas sem confirmação).
REQUIRE_EMAIL_VERIFICATION=

# ── Google reCAPTCHA v2 ("Não sou um robô") no login e no cadastro ────────
# Só liga se as DUAS chaves existirem. Crie em https://www.google.com/recaptcha/admin
# (tipo: reCAPTCHA v2 > Caixa de seleção) e cadastre os domínios: localhost e o do app.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
