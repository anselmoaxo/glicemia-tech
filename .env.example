# Neon PostgreSQL (use a connection string com sslmode=require)
DATABASE_URL=
# Better Auth: gere com `openssl rand -base64 32` (mínimo 32 caracteres)
BETTER_AUTH_SECRET=
# URL pública do app (em produção, o domínio da Vercel)
BETTER_AUTH_URL=http://localhost:3000
# Resend: convites e alertas por e-mail (opcional; sem a chave, o link do convite é exibido na tela)
RESEND_API_KEY=
EMAIL_FROM=Glicose Tech <onboarding@resend.dev>

# Google reCAPTCHA v2 ("Não sou um robô") no login e no cadastro. Só liga se as DUAS existirem.
# Crie em https://www.google.com/recaptcha/admin (tipo: reCAPTCHA v2 > Caixa de seleção "Não sou um robô")
# e cadastre os domínios: localhost e o domínio do app.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
